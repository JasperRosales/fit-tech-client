# FitTech environment configuration

# Gemini API key (required).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for the virtual fitting (optional).
# Defaults to gemini-3.1-flash-lite-image (Nano Banana 2 Lite), a free-tier
# friendly image generation model that can render the fitted photo.
# Other image-capable options:
#   gemini-3.1-flash-image   (Nano Banana 2)
#   gemini-2.5-flash-image   (Nano Banana)
# GEMINI_MODEL=gemini-3.1-flash-lite-image
